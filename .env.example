# Copy to .env and fill in real values for a live backend.
# Never commit the real .env file.

# --- Supabase (client-safe values only — never the service_role key) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Firebase (client-safe values only — never a service-account JSON) ---
FIREBASE_API_KEY=YOUR-FIREBASE-WEB-API-KEY
FIREBASE_APP_ID=YOUR-FIREBASE-APP-ID
FIREBASE_MESSAGING_SENDER_ID=YOUR-SENDER-ID
FIREBASE_PROJECT_ID=YOUR-FIREBASE-PROJECT-ID
# Web push requires a VAPID key pair from Firebase Console -> Project
# Settings -> Cloud Messaging -> Web configuration. Client-safe (public key).
FIREBASE_WEB_VAPID_KEY=YOUR-WEB-PUSH-VAPID-PUBLIC-KEY

# --- App mode ---
# true = use in-memory demo repositories and seeded demo accounts.
# false = use live Supabase repositories (requires the values above).
APP_DEMO_MODE=true
